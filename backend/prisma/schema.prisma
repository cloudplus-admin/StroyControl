// Prisma-схема — соответствует docs/DATABASE_SCHEMA.sql
// Полное описание всех модулей будет расширяться по мере разработки модулей Этапа 1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  users     User[]
  objects   Object[]
  auditLogs AuditLog[]
  idempotencyRecords IdempotencyRecord[]
  uploads   FileUpload[]
  documents ProjectDocument[]
  workActs  WorkAct[]

  @@map("companies")
}

model Role {
  id   Int    @id @default(autoincrement())
  code String @unique
  name String
  userRoles UserRole[]

  @@map("roles")
}

model User {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  company      Company  @relation(fields: [companyId], references: [id])
  email        String   @unique
  phone        String?
  fullName     String   @map("full_name")
  passwordHash String   @map("password_hash")
  locale       String   @default("ru")
  createdAt    DateTime @default(now()) @map("created_at")
  assignedTasks        Task[]
  reviewAssignments    Task[] @relation("TaskReviewer")
  authoredPhotoReports PhotoReport[]
  reportedDefects      Defect[]
  feedEvents           FeedEvent[]
  feedReactions        FeedReaction[]
  roles                UserRole[]
  sessions             Session[]
  auditLogs            AuditLog[]
  createdDocuments     ProjectDocument[] @relation("DocumentCreator")
  documentDecisions   DocumentApproval[]
  createdWorkActs      WorkAct[] @relation("ActCreator")
  signedWorkActs       WorkAct[] @relation("ActSigner")
  notifications        Notification[]

  @@map("users")
}

model Object {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  company      Company  @relation(fields: [companyId], references: [id])
  name         String
  nameUz       String?  @map("name_uz")
  address      String?
  addressUz    String?  @map("address_uz")
  templateCode String?  @map("template_code")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  stages       Stage[]
  photoReports PhotoReport[]
  defects      Defect[]
  feedEvents   FeedEvent[]
  userRoles    UserRole[]
  documents    ProjectDocument[]
  workActs     WorkAct[]

  @@map("objects")
}

model UserRole {
  id       String  @id @default(uuid())
  userId   String  @map("user_id")
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId   Int     @map("role_id")
  role     Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  objectId String? @map("object_id")
  object   Object? @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, objectId])
  @@index([userId])
  @@index([objectId])
  @@map("user_roles")
}

model Session {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokenHash  String    @unique @map("access_token_hash")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  accessExpiresAt  DateTime  @map("access_expires_at")
  refreshExpiresAt DateTime  @map("refresh_expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String   @map("company_id")
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  actorId    String?  @map("actor_id")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  payload    Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([companyId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model IdempotencyRecord {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key          String
  operation    String
  requestHash  String   @map("request_hash")
  responseBody Json?    @map("response_body")
  statusCode   Int?     @map("status_code")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([companyId, key])
  @@index([createdAt])
  @@map("idempotency_records")
}

model FileUpload {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploaderId   String?  @map("uploader_id")
  taskId       String?  @map("task_id")
  idempotencyKey String @map("idempotency_key")
  storageKey   String   @unique @map("storage_key")
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([companyId, createdAt])
  @@index([taskId])
  @@unique([companyId, idempotencyKey])
  @@map("file_uploads")
}

model Stage {
  id        String        @id @default(uuid())
  objectId  String        @map("object_id")
  object    Object        @relation(fields: [objectId], references: [id], onDelete: Cascade)
  name      String
  nameUz    String?       @map("name_uz")
  sortOrder Int           @default(0) @map("sort_order")
  sections  WorkSection[]

  @@index([objectId])
  @@map("stages")
}

model WorkSection {
  id        String @id @default(uuid())
  stageId   String @map("stage_id")
  stage     Stage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  name      String
  nameUz    String? @map("name_uz")
  sortOrder Int    @default(0) @map("sort_order")
  tasks     Task[]

  @@index([stageId])
  @@map("work_sections")
}

model Task {
  id               String      @id @default(uuid())
  workSectionId    String      @map("work_section_id")
  workSection      WorkSection @relation(fields: [workSectionId], references: [id], onDelete: Cascade)
  parentTaskId     String?     @map("parent_task_id")
  assigneeId       String?     @map("assignee_id")
  assignee         User?       @relation(fields: [assigneeId], references: [id])
  title            String
  titleUz          String?     @map("title_uz")
  description      String?
  descriptionUz    String?     @map("description_uz")
  status           String      @default("open")
  priority         String      @default("normal")
  tags             String[]    @default([])
  plannedStart     DateTime?   @map("planned_start")
  plannedEnd       DateTime?   @map("planned_end")
  baselineStart    DateTime?   @map("baseline_start")
  baselineEnd      DateTime?   @map("baseline_end")
  actualStart      DateTime?   @map("actual_start")
  actualEnd        DateTime?   @map("actual_end")
  dependsOn        String[]    @default([]) @map("depends_on")
  slaHours         Int?        @map("sla_hours")
  isRecurring      Boolean     @default(false) @map("is_recurring")
  recurrenceRule   String?     @map("recurrence_rule")
  closurePhotoUrl  String?     @map("closure_photo_url")
  closureGeoLat    Float?      @map("closure_geo_lat")
  closureGeoLng    Float?      @map("closure_geo_lng")
  closedAt         DateTime?   @map("closed_at")
  submittedAt      DateTime?   @map("submitted_at")
  reviewedAt       DateTime?   @map("reviewed_at")
  reviewedById     String?     @map("reviewed_by_id")
  reviewerId       String?     @map("reviewer_id")
  reviewer         User?       @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote       String?     @map("review_note")
  escalatedAt      DateTime?   @map("escalated_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  checklist        TaskChecklistItem[]
  photoReports     PhotoReport[]
  defects          Defect[]

  @@index([workSectionId])
  @@index([assigneeId])
  @@index([reviewerId])
  @@map("tasks")
}

model TaskChecklistItem {
  id     String  @id @default(uuid())
  taskId String  @map("task_id")
  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label  String
  labelUz String? @map("label_uz")
  isDone Boolean @default(false) @map("is_done")

  @@index([taskId])
  @@map("task_checklist_items")
}

model PhotoReport {
  id                 String   @id @default(uuid())
  objectId           String   @map("object_id")
  object             Object   @relation(fields: [objectId], references: [id], onDelete: Cascade)
  taskId             String?  @map("task_id")
  task               Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  authorId           String   @map("author_id")
  author             User     @relation(fields: [authorId], references: [id])
  shootingPoint      String?  @map("shooting_point")
  kind               String   @default("progress") // progress | before | after | hidden_works
  fileUrl            String   @map("file_url")
  requiredAngles     String[] @default([]) @map("required_angles")
  photos             Json     @default("[]")
  status             String   @default("draft") // draft | review | accepted | rejected
  geoLat             Float?   @map("geo_lat")
  geoLng             Float?   @map("geo_lng")
  inspectorSignature String?  @map("inspector_signature")
  inspectorNote      String?  @map("inspector_note")
  reviewedAt         DateTime? @map("reviewed_at")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([objectId])
  @@index([taskId])
  @@map("photo_reports")
}

model Defect {
  id         String   @id @default(uuid())
  objectId   String   @map("object_id")
  object     Object   @relation(fields: [objectId], references: [id], onDelete: Cascade)
  taskId     String?  @map("task_id")
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  reportedBy String   @map("reported_by")
  reporter   User     @relation(fields: [reportedBy], references: [id])
  status     String   @default("open") // open | in_progress | verified | closed
  description String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([objectId])
  @@map("defects")
}

model FeedEvent {
  id              String         @id @default(uuid())
  objectId        String         @map("object_id")
  object          Object         @relation(fields: [objectId], references: [id], onDelete: Cascade)
  authorId        String?        @map("author_id")
  author          User?          @relation(fields: [authorId], references: [id])
  kind            String         @default("message") // message | status_change | acceptance | file
  body            String?
  mentionedUserIds String[]      @default([]) @map("mentioned_user_ids")
  parentEventId   String?        @map("parent_event_id")
  parentEvent     FeedEvent?     @relation("FeedThread", fields: [parentEventId], references: [id], onDelete: SetNull)
  replies         FeedEvent[]    @relation("FeedThread")
  reactions       FeedReaction[]
  createdAt       DateTime       @default(now()) @map("created_at")

  @@index([objectId, createdAt])
  @@index([parentEventId])
  @@map("feed_events")
}

model FeedReaction {
  id        String    @id @default(uuid())
  eventId   String    @map("event_id")
  event     FeedEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  emoji     String
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([eventId, userId])
  @@map("feed_reactions")
}

model ProjectDocument {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  objectId    String   @map("object_id")
  object      Object   @relation(fields: [objectId], references: [id], onDelete: Cascade)
  createdById String   @map("created_by_id")
  createdBy   User     @relation("DocumentCreator", fields: [createdById], references: [id])
  title       String
  kind        String
  version     Int      @default(1)
  fileUrl     String   @map("file_url")
  status      String   @default("draft")
  createdAt   DateTime @default(now()) @map("created_at")
  approvals   DocumentApproval[]

  @@index([companyId, objectId, createdAt])
  @@map("project_documents")
}

model DocumentApproval {
  id         String          @id @default(uuid())
  documentId String          @map("document_id")
  document   ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actorId    String          @map("actor_id")
  actor      User            @relation(fields: [actorId], references: [id])
  decision   String
  note       String?
  createdAt  DateTime        @default(now()) @map("created_at")

  @@unique([documentId, actorId])
  @@map("document_approvals")
}

model WorkAct {
  id          String    @id @default(uuid())
  companyId   String    @map("company_id")
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  objectId    String    @map("object_id")
  object      Object    @relation(fields: [objectId], references: [id], onDelete: Cascade)
  createdById String    @map("created_by_id")
  createdBy   User      @relation("ActCreator", fields: [createdById], references: [id])
  signedById  String?   @map("signed_by_id")
  signedBy    User?     @relation("ActSigner", fields: [signedById], references: [id])
  template    String
  number      String
  title       String
  amount      Decimal   @db.Decimal(14, 2)
  status      String    @default("draft")
  pdfUrl      String?   @map("pdf_url")
  signedAt    DateTime? @map("signed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([companyId, number])
  @@index([companyId, objectId, createdAt])
  @@map("work_acts")
}

model Notification {
  id         String    @id @default(uuid())
  companyId  String    @map("company_id")
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  objectId   String?   @map("object_id")
  kind       String
  title      String
  body       String
  entityType String?   @map("entity_type")
  entityId   String?   @map("entity_id")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([companyId, userId, readAt, createdAt])
  @@map("notifications")
}

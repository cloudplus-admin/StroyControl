// Prisma-схема — соответствует docs/DATABASE_SCHEMA.sql
// Полное описание всех модулей будет расширяться по мере разработки модулей Этапа 1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  users     User[]
  objects   Object[]

  @@map("companies")
}

model Role {
  id   Int    @id @default(autoincrement())
  code String @unique
  name String

  @@map("roles")
}

model User {
  id                       String             @id @default(uuid())
  companyId                String             @map("company_id")
  company                  Company            @relation(fields: [companyId], references: [id])
  email                    String             @unique
  phone                    String?
  fullName                 String             @map("full_name")
  passwordHash             String             @map("password_hash")
  locale                   String             @default("ru")
  createdAt                DateTime           @default(now()) @map("created_at")
  assignedTasks            Task[]
  authoredPhotoReports     PhotoReport[]
  reportedDefects          Defect[]
  feedEvents               FeedEvent[]
  feedReactions            FeedReaction[]
  uploadedDocumentVersions DocumentVersion[]
  raisedApprovals          CustomerApproval[] @relation("ApprovalRaisedBy")
  respondedApprovals       CustomerApproval[] @relation("ApprovalRespondedBy")

  @@map("users")
}

model Object {
  id                String             @id @default(uuid())
  companyId         String             @map("company_id")
  company           Company            @relation(fields: [companyId], references: [id])
  name              String
  address           String?
  templateCode      String?            @map("template_code")
  status            String             @default("active")
  createdAt         DateTime           @default(now()) @map("created_at")
  stages            Stage[]
  photoReports      PhotoReport[]
  defects           Defect[]
  feedEvents        FeedEvent[]
  documents         Document[]
  paymentSchedules  PaymentSchedule[]
  customerApprovals CustomerApproval[]

  @@map("objects")
}

model Stage {
  id                String             @id @default(uuid())
  objectId          String             @map("object_id")
  object            Object             @relation(fields: [objectId], references: [id], onDelete: Cascade)
  name              String
  sortOrder         Int                @default(0) @map("sort_order")
  sections          WorkSection[]
  customerApprovals CustomerApproval[]

  @@index([objectId])
  @@map("stages")
}

model WorkSection {
  id        String @id @default(uuid())
  stageId   String @map("stage_id")
  stage     Stage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int    @default(0) @map("sort_order")
  tasks     Task[]

  @@index([stageId])
  @@map("work_sections")
}

model Task {
  id                String              @id @default(uuid())
  workSectionId     String              @map("work_section_id")
  workSection       WorkSection         @relation(fields: [workSectionId], references: [id], onDelete: Cascade)
  parentTaskId      String?             @map("parent_task_id")
  assigneeId        String?             @map("assignee_id")
  assignee          User?               @relation(fields: [assigneeId], references: [id])
  title             String
  description       String?
  status            String              @default("open")
  priority          String              @default("normal")
  tags              String[]            @default([])
  plannedStart      DateTime?           @map("planned_start")
  plannedEnd        DateTime?           @map("planned_end")
  baselineStart     DateTime?           @map("baseline_start")
  baselineEnd       DateTime?           @map("baseline_end")
  actualStart       DateTime?           @map("actual_start")
  actualEnd         DateTime?           @map("actual_end")
  dependsOn         String[]            @default([]) @map("depends_on")
  slaHours          Int?                @map("sla_hours")
  isRecurring       Boolean             @default(false) @map("is_recurring")
  recurrenceRule    String?             @map("recurrence_rule")
  closurePhotoUrl   String?             @map("closure_photo_url")
  closureGeoLat     Float?              @map("closure_geo_lat")
  closureGeoLng     Float?              @map("closure_geo_lng")
  closedAt          DateTime?           @map("closed_at")
  escalatedAt       DateTime?           @map("escalated_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  checklist         TaskChecklistItem[]
  photoReports      PhotoReport[]
  defects           Defect[]
  customerApprovals CustomerApproval[]

  @@index([workSectionId])
  @@index([assigneeId])
  @@map("tasks")
}

model TaskChecklistItem {
  id     String  @id @default(uuid())
  taskId String  @map("task_id")
  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label  String
  isDone Boolean @default(false) @map("is_done")

  @@index([taskId])
  @@map("task_checklist_items")
}

model PhotoReport {
  id                 String    @id @default(uuid())
  objectId           String    @map("object_id")
  object             Object    @relation(fields: [objectId], references: [id], onDelete: Cascade)
  taskId             String?   @map("task_id")
  task               Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  authorId           String    @map("author_id")
  author             User      @relation(fields: [authorId], references: [id])
  shootingPoint      String?   @map("shooting_point")
  kind               String    @default("progress") // progress | before | after | hidden_works
  fileUrl            String    @map("file_url")
  geoLat             Float?    @map("geo_lat")
  geoLng             Float?    @map("geo_lng")
  inspectorSignature String?   @map("inspector_signature")
  documentId         String?   @map("document_id") // привязка к акту выполненных работ (модуль «Документооборот»)
  document           Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now()) @map("created_at")

  @@index([objectId])
  @@index([taskId])
  @@index([documentId])
  @@map("photo_reports")
}

model Defect {
  id          String   @id @default(uuid())
  objectId    String   @map("object_id")
  object      Object   @relation(fields: [objectId], references: [id], onDelete: Cascade)
  taskId      String?  @map("task_id")
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  reportedBy  String   @map("reported_by")
  reporter    User     @relation(fields: [reportedBy], references: [id])
  status      String   @default("open") // open | in_progress | verified | closed
  description String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([objectId])
  @@map("defects")
}

model FeedEvent {
  id               String         @id @default(uuid())
  objectId         String         @map("object_id")
  object           Object         @relation(fields: [objectId], references: [id], onDelete: Cascade)
  authorId         String?        @map("author_id")
  author           User?          @relation(fields: [authorId], references: [id])
  kind             String         @default("message") // message | status_change | acceptance | file
  body             String?
  mentionedUserIds String[]       @default([]) @map("mentioned_user_ids")
  parentEventId    String?        @map("parent_event_id")
  parentEvent      FeedEvent?     @relation("FeedThread", fields: [parentEventId], references: [id], onDelete: SetNull)
  replies          FeedEvent[]    @relation("FeedThread")
  reactions        FeedReaction[]
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([objectId, createdAt])
  @@index([parentEventId])
  @@map("feed_events")
}

model FeedReaction {
  id        String    @id @default(uuid())
  eventId   String    @map("event_id")
  event     FeedEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  emoji     String
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([eventId, userId])
  @@map("feed_reactions")
}

// Документооборот: хранилище документов с версионностью (чертежи, сметы,
// договоры, акты, исполнительная документация). Реальная загрузка файлов (S3)
// не реализована — API принимает уже готовый fileUrl, как и в photocontrol.
model Document {
  id           String            @id @default(uuid())
  objectId     String            @map("object_id")
  object       Object            @relation(fields: [objectId], references: [id], onDelete: Cascade)
  title        String
  docType      String            @map("doc_type") // drawing | estimate | contract | act | as_built | certificate
  templateCode String?           @map("template_code") // код шаблона акта/справки под формы РУз (раздел 9 ТЗ), без генерации PDF
  createdAt    DateTime          @default(now()) @map("created_at")
  versions     DocumentVersion[]
  photoReports PhotoReport[]

  @@index([objectId])
  @@map("documents")
}

// Версии документа — контроль версий и история изменений (кто и когда менял).
// Этап 2: э-подпись и маршруты согласования версий не реализованы.
model DocumentVersion {
  id           String   @id @default(uuid())
  documentId   String   @map("document_id")
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNo    Int      @map("version_no")
  fileUrl      String   @map("file_url")
  uploadedById String   @map("uploaded_by")
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([documentId, versionNo])
  @@index([documentId])
  @@map("document_versions")
}

// Кабинет заказчика, Этап 1: график оплат по объекту. Лёгкая заглушка —
// планируемые платежи с датой и статусом. Полноценный модуль «Финансы и
// бюджет объекта» (P&L, план/факт, S-кривая, KPI) — Этап 2 (раздел 10 ТЗ),
// здесь не реализуется. Суммы хранятся как Float (как geo-координаты в
// photocontrol) — для реального финансового учёта в Этапе 2 потребуется
// Decimal/NUMERIC.
model PaymentSchedule {
  id          String    @id @default(uuid())
  objectId    String    @map("object_id")
  object      Object    @relation(fields: [objectId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  dueDate     DateTime  @map("due_date")
  status      String    @default("pending") // pending | paid | overdue
  paidAt      DateTime? @map("paid_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([objectId])
  @@map("payment_schedules")
}

// Кабинет заказчика, Этап 1: согласования и замечания заказчика, зафиксированные
// прямо в системе (вместо звонков менеджеру). Привязка к объекту обязательна,
// к этапу/задаче — опционально. Реального клиентского логина/JWT нет — как и
// везде в системе, доступ временно ограничен заголовком x-company-id.
model CustomerApproval {
  id              String    @id @default(uuid())
  objectId        String    @map("object_id")
  object          Object    @relation(fields: [objectId], references: [id], onDelete: Cascade)
  stageId         String?   @map("stage_id")
  stage           Stage?    @relation(fields: [stageId], references: [id], onDelete: SetNull)
  taskId          String?   @map("task_id")
  task            Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  title           String
  comment         String?
  status          String    @default("pending") // pending | approved | changes_requested
  raisedById      String    @map("raised_by")
  raisedBy        User      @relation("ApprovalRaisedBy", fields: [raisedById], references: [id])
  responseComment String?   @map("response_comment")
  respondedById   String?   @map("responded_by")
  respondedBy     User?     @relation("ApprovalRespondedBy", fields: [respondedById], references: [id])
  respondedAt     DateTime? @map("responded_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([objectId])
  @@index([stageId])
  @@index([taskId])
  @@map("customer_approvals")
}

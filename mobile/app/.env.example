# Базовый URL backend API (см. src/config/env.ts). Expo инлайнит переменные с
# префиксом EXPO_PUBLIC_ в бандл на этапе сборки/старта.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# Временная замена авторизации — заголовок x-company-id на каждый запрос
# (см. backend requireCompanyId() во всех модулях). Уйдёт, когда появится логин.
EXPO_PUBLIC_COMPANY_ID=demo-company

{
  "expo": {
    "name": "StroyControl",
    "slug": "stroycontrol",
    "version": "1.0.20",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "uz.cloudplus.stroycontrol",
      "versionCode": 33,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "./plugins/withAndroidReleaseSigning",
      [
        "expo-image-picker",
        {
          "photosPermission": "Фото нужно для подтверждения выполненных работ",
          "cameraPermission": "Камера нужна для фотоотчетов со стройплощадки"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Геолокация нужна для подтверждения нахождения на объекте"
        }
      ],
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "Камера нужна для сканирования QR инструмента"
        }
      ],
      "expo-sharing",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true
          }
        }
      ]
    ]
  }
}

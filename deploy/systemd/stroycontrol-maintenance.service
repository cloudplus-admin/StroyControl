[Unit]
Description=StroyControl scheduled task maintenance
After=network-online.target

[Service]
Type=oneshot
User=stroycontrol
Group=stroycontrol
WorkingDirectory=/opt/stroycontrol/backend
EnvironmentFile=/etc/stroycontrol/backend.env
ExecStart=/usr/bin/npm run maintenance
Nice=10
NoNewPrivileges=true
PrivateTmp=true

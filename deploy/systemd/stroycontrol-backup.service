[Unit]
Description=Create StroyControl database and uploads backup
After=network-online.target

[Service]
Type=oneshot
User=stroycontrol
Group=stroycontrol
WorkingDirectory=/opt/stroycontrol/backend
EnvironmentFile=/etc/stroycontrol/backend.env
Environment=BACKUP_DIR=/var/backups/stroycontrol
ExecStart=/opt/stroycontrol/backend/scripts/backup.sh
Nice=10
NoNewPrivileges=true
PrivateTmp=true
